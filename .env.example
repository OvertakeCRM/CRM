# Supabase project settings (Project Settings → API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Service role key — server-only, NEVER expose to the client. Used for admin
# actions like inviting reps. Project Settings → API → service_role secret.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Google Cloud Console → APIs & Services → Credentials. Enable "Maps JavaScript API"
# and "Places API" for this key, and restrict it to your domain(s).
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# The deployed URL of this app (used to build email redirect links).
# Use http://localhost:3000 for local development.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
